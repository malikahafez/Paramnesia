--- !u!114 &755798755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 755798753}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4d8e7cb1272ffd244ac09fcf6e6161cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Ghost Merchant
    lines:
    - sentence: BOO!
      animationTrigger: yes
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Greetings, human!
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: 'Oh, it''s YOU. '
      animationTrigger: yes
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Everyone's been whispering about you. I was wondering when you would
        finally come over.
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: 'Curious thing, not everyone who ends up here lives to tell the tale... '
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Of course, they can DIE to tell it!
      animationTrigger: thankyou
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: But it seems to me that your mind is bit... LOST.
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Never fear, you have come to the right place. Welcome to my SHOP!!!!
      animationTrigger: celebrate
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: I have everything to fulfil your needs, from magical POTIONS to magical
        SALVE... But for a PRICE of course.
      animationTrigger: yes
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Unfortunately, I don't have anything to jog that MEMORY of yours.
        You will have to figure that out yourself!
      animationTrigger: no
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: "But I promise you will find something worth your while! \n^-^"
      animationTrigger: celebrate
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    characterAnimator: {fileID: 6728204819512177075}
