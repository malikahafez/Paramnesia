  m_Script: {fileID: 11500000, guid: 4d8e7cb1272ffd244ac09fcf6e6161cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Resident Ghost
    lines:
    - sentence: Hey, buddy
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Got a second?
      animationTrigger: thankyou
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: I have a business proposition for you.
      animationTrigger: yes
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: "I can see you have a certain \u2026 mnemonic predicament"
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: "You need your memories back, and I need parts\u2026"
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: Zombie parts to be exact.
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: "What say you get me 20 BONEs and 15 SLIME flasks, and 5 HEARTs and
        I give you some spare KEY FRAGMENTs I have lying around\u2026\r\n"
      animationTrigger: yes
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: AND some of your memories.
      animationTrigger: 
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    - sentence: So, do we have a deal?
      animationTrigger: thankyou
      sentenceAudio: {fileID: 0}
      audioVolume: 0
    characterAnimator: {fileID: 1493806337}
